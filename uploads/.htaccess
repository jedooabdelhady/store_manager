# حماية: منع تشغيل أي ملفات برمجية داخل مجلد الرفع
<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
